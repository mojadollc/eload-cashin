{
  "expo": {
    "name": "CashIn Tap",
    "slug": "cashin-tap",
    "scheme": "cashintap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dashioo.cashintapmobile",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to unlock your CashIn Tap account",
        "NSCameraUsageDescription": "Used to scan QR codes for payments"
      }
    },
    "android": {
      "ndkVersion": "30.0.16248370",
      "adaptiveIcon": {
        "backgroundColor": "#0D0F1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.cashintap.app",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID to unlock your CashIn Tap account"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CashIn Tap to access your camera to scan QR codes."
        }
      ],
      "./plugins/withAndroidFixes",
      "@react-native-firebase/app",
      "@react-native-firebase/auth"
    ],
    "extra": {
      "eas": {
        "projectId": "8a40d613-281f-44c5-bb9f-8af7dd6c792c"
      }
    }
  }
}
