{
  "expo": {
    "name": "CashIn Tap",
    "slug": "cashin-tap",
    "version": "1.0.0",
    "sdkVersion": "54.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "cashintap",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cashintap.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to authenticate",
        "NSCameraUsageDescription": "Scan QR codes for payments"
      }
    },
    "android": {
      "package": "com.cashintap.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "CAMERA",
        "VIBRATE"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow CashIn Tap to use Face ID"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
